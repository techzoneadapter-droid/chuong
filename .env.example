# Optional Supabase overrides for staging/future key rotation.
# Production CHƯƠNG uses a public Supabase URL + publishable key by default.
# Publishable keys are safe in browser/mobile clients when RLS is enabled.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Set to "demo" to force local/demo mode without contacting Supabase.
# EXPO_PUBLIC_SUPABASE_MODE=demo
