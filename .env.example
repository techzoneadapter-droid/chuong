# Optional Supabase overrides for staging/future key rotation.
# Production CHƯƠNG uses a public Supabase URL + publishable key by default.
# Publishable keys are safe in browser/mobile clients when RLS is enabled.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Set to "demo" to force local/demo mode without contacting Supabase.
# EXPO_PUBLIC_SUPABASE_MODE=demo

# Public web app URL used in shared reader links. If omitted, CHƯƠNG falls back to the native chuong:// deep link.
EXPO_PUBLIC_APP_URL=https://your-public-app.example

# preview uses demo; release uses staging and refuses the production project.
# Set these public staging values in the EAS preview environment.
# EXPO_PUBLIC_SUPABASE_MODE=staging
# Ads stay test-only unless explicitly configured for production after QA.
EXPO_PUBLIC_ADS_MODE=test
