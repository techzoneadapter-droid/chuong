{
  "expo": {
    "name": "CHƯƠNG",
    "slug": "chuong",
    "scheme": "chuong",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép CHƯƠNG chọn ảnh bìa và ảnh đại diện."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.chuong.app"
    },
    "android": {
      "package": "vn.chuong.app"
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
