{
  "expo": {
    "name": "CHƯƠNG",
    "slug": "chuong",
    "icon": "./assets/xianxia/icon.png",
    "scheme": "chuong",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép CHƯƠNG chọn ảnh bìa và ảnh đại diện."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.chuong.app"
    },
    "android": {
      "package": "vn.chuong.app"
    },
    "web": {
      "favicon": "./assets/xianxia/icon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
