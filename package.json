{
  "name": "chuong",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --web --port 3000 --host lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 3000 --host lan",
    "typecheck": "tsc --noEmit",
    "dev": "expo start --web --port 3000 --host lan",
    "build": "expo export --platform web",
    "test:db": "node tests/database.mjs",
    "test:web": "playwright test",
    "native:android": "expo run:android",
    "native:ios": "expo run:ios",
    "test:release": "node tests/release.mjs",
    "verify": "npm run typecheck && npm run test:ui-copy && npm run test:admin-web && npm run test:release && npm run test:db && npm run build",
    "test:ui-copy": "node tests/ui-copy.mjs",
    "test:admin-web": "node --check admin-web/app.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~54.0.20",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-iap": "5.8.2",
    "expo-image-picker": "~17.0.11",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.13",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-google-mobile-ads": "16.5.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
